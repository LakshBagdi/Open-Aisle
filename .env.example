# Copy to .env at the repository root (pnpm demo does it for you).
# One file is enough for every part of Open Aisle. Never commit .env.
# Everything works as it is, with the fake PayPal and no AI key (simple mode).

DATABASE_URL=postgres://openaisle:openaisle@localhost:5432/openaisle
APP_URL=http://localhost:3000

# ── PayPal ─────────────────────────────────────────────────────────────
# Out of the box: the built-in fake PayPal (started by `pnpm demo`).
PAYPAL_API_BASE=http://127.0.0.1:4010
PAYPAL_WEBHOOK_ID=FAKE-WEBHOOK-ID
# Real sandbox instead: delete the two lines above, create a Merchant app at
# developer.paypal.com (Sandbox), turn on "Save PayPal and Venmo payment
# methods" for the sandbox business account, add a webhook to
# <APP_URL>/api/paypal/webhook, and fill these in (and its webhook id above).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── AI ─────────────────────────────────────────────────────────────────
# Pick one provider. anthropic (Claude) is the default and the best fit;
# google (Gemini) and groq have free tiers.
AI_PROVIDER=anthropic
# No key for the chosen provider? The Shop page still works, in simple mode (short requests).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
SMALL_MODEL=claude-haiku-5-5
# Gemini: AI_PROVIDER=google, key from https://aistudio.google.com/apikey
#   AGENT_MODEL=gemini-3.8-flash
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq: AI_PROVIDER=groq, key from https://console.groq.com/keys
#   AGENT_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# ── Product data (optional: live price checks and real catalogs) ───────
CHANNEL3_API_KEY=

# ── Trust layer secrets: generate with
#    pnpm --filter @open-aisle/core exec tsx scripts/gen-keys.ts
RULES_SIGNING_KEY=
CONFIRM_TOKEN_SECRET=

# ── Background work ────────────────────────────────────────────────────
# Local: the web app charges orders when their undo window ends.
INLINE_WORKER=true
# Production: Render Workflows does it durably.
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=open-aisle-worker

# ── Hosted demo ────────────────────────────────────────────────────────
# per-visitor: each browser gets its own demo shopper (set on Render).
# Leave empty locally: everyone is the demo shopper Asha.
DEMO_SESSIONS=

# ── MCP server (pnpm mcp) ──────────────────────────────────────────────
# Which shopper an outside AI agent shops for (default: the demo shopper Asha).
OPEN_AISLE_USER_ID=
