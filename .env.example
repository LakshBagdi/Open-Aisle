# Copy to .env (and to apps/web/.env and packages/core/.env), then fill in.
# Never commit .env.

DATABASE_URL=postgres://openaisle:openaisle@localhost:5432/openaisle
APP_URL=http://localhost:3000

# ── PayPal ─────────────────────────────────────────────────────────────
# Real sandbox: create a Merchant app at developer.paypal.com (Sandbox),
# turn on "Save PayPal and Venmo payment methods" for the sandbox business
# account, and add a webhook to <APP_URL>/api/paypal/webhook.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# No PayPal keys? Run `pnpm fake-paypal` and uncomment this line.
# PAYPAL_API_BASE=http://127.0.0.1:4010
# (with the fake, PAYPAL_WEBHOOK_ID=FAKE-WEBHOOK-ID)

# ── AI ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
SMALL_MODEL=claude-haiku-5-5

# ── Product data (optional: live price checks and real catalogs) ───────
CHANNEL3_API_KEY=

# ── Trust layer secrets: generate with
#    pnpm --filter @open-aisle/core exec tsx scripts/gen-keys.ts
RULES_SIGNING_KEY=
CONFIRM_TOKEN_SECRET=

# ── Background work ────────────────────────────────────────────────────
# Local: the web app charges orders when their undo window ends.
INLINE_WORKER=true
# Production: Render Workflows does it durably.
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=open-aisle-worker

# ── Hosted demo ────────────────────────────────────────────────────────
# per-visitor: each browser gets its own demo shopper (set on Render).
# Leave empty locally: everyone is the demo shopper Asha.
DEMO_SESSIONS=

# ── MCP server (pnpm mcp) ──────────────────────────────────────────────
# Which shopper an outside AI agent shops for (default: the demo shopper Asha).
OPEN_AISLE_USER_ID=
